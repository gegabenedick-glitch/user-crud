rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /books/{bookId} {
      function validBook(data) {
        return data.keys().hasAll(['title', 'author', 'genre', 'notes', 'readDate', 'createdAt'])
          && data.keys().hasOnly(['title', 'author', 'genre', 'notes', 'readDate', 'createdAt'])
          && data.title is string && data.title.size() > 0 && data.title.size() <= 160
          && data.author is string && data.author.size() <= 120
          && data.genre is string && data.genre.size() <= 80
          && data.notes is string && data.notes.size() <= 2000
          && data.readDate is string && data.readDate.size() <= 10
          && data.createdAt is string;
      }

      allow read, delete: if true;
      allow create, update: if validBook(request.resource.data);
    }

    match /users/{userId} {
      function validUser(data) {
        return data.keys().hasAll(['name', 'email', 'phone', 'createdAt'])
          && data.keys().hasOnly(['name', 'email', 'phone', 'createdAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 120
          && data.email is string && data.email.size() > 0 && data.email.size() <= 160
          && data.phone is string && data.phone.size() <= 30
          && data.createdAt is string;
      }

      allow read, delete: if true;
      allow create, update: if validUser(request.resource.data);
    }
  }
}